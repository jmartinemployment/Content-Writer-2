+using GeekAPI.HttpClients;
+using GeekApplication;
+using GeekApplication.Models.ContentWriterV4;
+using Microsoft.AspNetCore.Mvc;
+
+namespace GeekAPI.Controllers.ContentWriterV4;
+
+[ApiController]
+[Route("api/content-writer/v4/brand-voices")]
+public class BrandVoicesController : ControllerBase
+{
+    private readonly HttpContentWriterV4Repository _repo;
+
+    public BrandVoicesController(HttpContentWriterV4Repository repo)
+    {
+        _repo = repo;
+    }
+
+    [HttpGet]
+    public async Task<ActionResult<IReadOnlyList<BrandVoiceDto>>> List(CancellationToken ct)
+    {
+        return Ok(await _repo.GetBrandVoicesAsync(ContentWriterV4Constants.DevUserId, ct));
+    }
+
+    [HttpGet("{id:guid}")]
+    public async Task<ActionResult<BrandVoiceDto>> Get(Guid id, CancellationToken ct)
+    {
+        var voice = await _repo.GetBrandVoiceByIdAsync(id, ct);
+        return voice == null ? NotFound() : Ok(voice);
+    }
+
+    [HttpPost]
+    public async Task<ActionResult<BrandVoiceDto>> Create([FromBody] UpsertBrandVoiceRequest request, CancellationToken ct)
+    {
+        var created = await _repo.CreateBrandVoiceAsync(new CreateBrandVoiceCommand(
+            ContentWriterV4Constants.DevUserId,
+            request.Name,
+            request.Description,
+            request.Tone,
+            request.SampleText), ct);
+        return CreatedAtAction(nameof(Get), new { id = created.Id }, created);
+    }
+
+    [HttpPut("{id:guid}")]
+    public async Task<ActionResult<BrandVoiceDto>> Update(Guid id, [FromBody] UpsertBrandVoiceRequest request, CancellationToken ct)
+    {
+        var updated = await _repo.UpdateBrandVoiceAsync(id, new UpdateBrandVoiceCommand(
+            request.Name,
+            request.Description,
+            request.Tone,
+            request.SampleText), ct);
+        return updated == null ? NotFound() : Ok(updated);
+    }
+
+    [HttpDelete("{id:guid}")]
+    public async Task<IActionResult> Delete(Guid id, CancellationToken ct)
+    {
+        var deleted = await _repo.DeleteBrandVoiceAsync(id, ContentWriterV4Constants.DevUserId, ct);
+        return deleted ? NoContent() : NotFound();
+    }
+}
+
+public sealed record UpsertBrandVoiceRequest(
+    string Name,
+    string Description,
+    string Tone,
+    string SampleText);
