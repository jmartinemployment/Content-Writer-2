+using System.Text;
+using System.Text.Json;
+using GeekAPI.HttpClients;
+using GeekAPI.Services.ContentWriterV4;
+using GeekApplication.Interfaces.ContentWriterV4;
+using GeekApplication.Models.ContentWriterV4;
+using Microsoft.AspNetCore.Mvc;
+
+namespace GeekAPI.Controllers.ContentWriterV4;
+
+[ApiController]
+[Route("api/content-writer/v4")]
+public class GenerateController : ControllerBase
+{
+    private readonly HttpContentWriterV4Repository _repo;
+    private readonly ILlmProviderV4Factory _providerFactory;
+    private readonly ILogger<GenerateController> _logger;
+
+    public GenerateController(
+        HttpContentWriterV4Repository repo,
+        ILlmProviderV4Factory providerFactory,
+        ILogger<GenerateController> logger)
+    {
+        _repo = repo;
+        _providerFactory = providerFactory;
+        _logger = logger;
+    }
+
+    [HttpPost("generate")]
+    public async Task<ActionResult<GenerateContentResponse>> Generate(
+        [FromBody] GenerateContentRequest request,
+        CancellationToken ct)
+    {
+        var template = await _repo.GetTemplateByIdAsync(request.TemplateId, ct);
+        if (template == null)
+            return NotFound(new { error = "template not found" });
+
+        var missing = template.InputSchema
+            .Where(f => f.Required)
+            .Where(f => !request.Inputs.TryGetValue(f.Key, out var value) || string.IsNullOrWhiteSpace(value))
+            .Select(f => f.Key)
+            .ToList();
+        if (missing.Count > 0)
+        {
+            return BadRequest(new { error = "missing required fields", fields = missing });
+        }
+
+        var systemPrompt = template.SystemPrompt;
+        if (request.BrandVoiceId.HasValue)
+        {
+            var voice = await _repo.GetBrandVoiceByIdAsync(request.BrandVoiceId.Value, ct);
+            if (voice != null)
+            {
+                systemPrompt += $"\n\nBrand voice — {voice.Name} ({voice.Tone}): {voice.Description}\nSample style:\n{voice.SampleText}";
+            }
+        }
+
+        var userPrompt = Interpolate(template.UserPromptTemplate, request.Inputs);
+        var provider = _providerFactory.GetProvider(request.Provider);
+
+        GenerationResult result;
+        try
+        {
+            result = await provider.GenerateAsync(systemPrompt, userPrompt, ct: ct);
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError(ex, "LLM generation failed for template {TemplateId}", request.TemplateId);
+            return StatusCode(502, new { error = "generation failed", detail = ex.Message });
+        }
+
+        var cost = await _repo.CalculateCostAsync(
+            result.Provider, result.Model, result.InputTokens, result.OutputTokens, ct);
+
+        var inputsJson = JsonSerializer.SerializeToElement(request.Inputs);
+        var generation = await _repo.CreateGenerationAsync(new CreateGenerationCommand(
+            request.DocumentId,
+            request.TemplateId,
+            request.BrandVoiceId,
+            result.Provider,
+            result.Model,
+            inputsJson,
+            result.Output,
+            result.InputTokens,
+            result.OutputTokens,
+            cost), ct);
+
+        return Ok(new GenerateContentResponse(
+            result.Output,
+            new GenerationUsageDto(result.Provider, result.Model, result.InputTokens, result.OutputTokens, cost),
+            generation.Id));
+    }
+
+    private static string Interpolate(string template, Dictionary<string, string> inputs)
+    {
+        var sb = new StringBuilder(template);
+        foreach (var (key, value) in inputs)
+            sb.Replace("{{" + key + "}}", value ?? string.Empty);
+        return sb.ToString();
+    }
+}
