+using System.Text.Json;
+using GeekApplication.Interfaces.ContentWriterV4;
+using GeekApplication.Models.ContentWriterV4;
+using GeekRepository.Data;
+using GeekRepository.Data.Entities.ContentWriterV4;
+using Microsoft.EntityFrameworkCore;
+
+namespace GeekRepository.Repositories.ContentWriterV4;
+
+public class DocumentRepository : IDocumentRepository
+{
+    private static readonly JsonSerializerOptions JsonOpts = new()
+    {
+        PropertyNameCaseInsensitive = true,
+    };
+
+    private readonly ContentWriterV4DbContext _db;
+
+    public DocumentRepository(ContentWriterV4DbContext db)
+    {
+        _db = db;
+    }
+
+    public async Task<IReadOnlyList<DocumentDto>> GetByOwnerIdAsync(Guid ownerId, CancellationToken ct = default)
+    {
+        var entities = await _db.Documents.AsNoTracking()
+            .Where(d => d.OwnerId == ownerId)
+            .OrderByDescending(d => d.UpdatedAtUtc)
+            .ToListAsync(ct);
+        return entities.Select(MapToDto).ToList().AsReadOnly();
+    }
+
+    public async Task<DocumentDto?> GetByIdAsync(Guid id, CancellationToken ct = default)
+    {
+        var entity = await _db.Documents.AsNoTracking().FirstOrDefaultAsync(d => d.Id == id, ct);
+        return entity == null ? null : MapToDto(entity);
+    }
+
+    public async Task<DocumentDto> CreateAsync(CreateDocumentCommand command, CancellationToken ct = default)
+    {
+        var now = DateTime.UtcNow;
+        var entity = new Document
+        {
+            OwnerId = command.OwnerId,
+            TemplateId = command.TemplateId,
+            BrandVoiceId = command.BrandVoiceId,
+            Title = command.Title,
+            InputsJson = command.Inputs.ValueKind == JsonValueKind.Undefined
+                ? "{}"
+                : command.Inputs.GetRawText(),
+            Content = command.Content,
+            CreatedAtUtc = now,
+            UpdatedAtUtc = now,
+        };
+        _db.Documents.Add(entity);
+        await _db.SaveChangesAsync(ct);
+        return MapToDto(entity);
+    }
+
+    public async Task<DocumentDto?> UpdateAsync(Guid id, UpdateDocumentCommand command, CancellationToken ct = default)
+    {
+        var entity = await _db.Documents.FirstOrDefaultAsync(d => d.Id == id, ct);
+        if (entity == null) return null;
+
+        entity.Title = command.Title;
+        entity.InputsJson = command.Inputs.ValueKind == JsonValueKind.Undefined
+            ? entity.InputsJson
+            : command.Inputs.GetRawText();
+        entity.Content = command.Content;
+        entity.BrandVoiceId = command.BrandVoiceId;
+        entity.UpdatedAtUtc = DateTime.UtcNow;
+        await _db.SaveChangesAsync(ct);
+        return MapToDto(entity);
+    }
+
+    public async Task<bool> DeleteAsync(Guid id, Guid ownerId, CancellationToken ct = default)
+    {
+        var entity = await _db.Documents.FirstOrDefaultAsync(d => d.Id == id && d.OwnerId == ownerId, ct);
+        if (entity == null) return false;
+        _db.Documents.Remove(entity);
+        await _db.SaveChangesAsync(ct);
+        return true;
+    }
+
+    private static DocumentDto MapToDto(Document entity)
+    {
+        using var doc = JsonDocument.Parse(string.IsNullOrWhiteSpace(entity.InputsJson) ? "{}" : entity.InputsJson);
+        return new DocumentDto(
+            entity.Id,
+            entity.OwnerId,
+            entity.TemplateId,
+            entity.BrandVoiceId,
+            entity.Title,
+            doc.RootElement.Clone(),
+            entity.Content,
+            entity.CreatedAtUtc,
+            entity.UpdatedAtUtc);
+    }
+}
