+using System.Text.Json;
+using GeekApplication.Interfaces.ContentWriterV4;
+using GeekApplication.Models.ContentWriterV4;
+using GeekRepository.Data;
+using GeekRepository.Data.Entities.ContentWriterV4;
+using Microsoft.EntityFrameworkCore;
+
+namespace GeekRepository.Repositories.ContentWriterV4;
+
+public class TemplateRepository : ITemplateRepository
+{
+    private static readonly JsonSerializerOptions JsonOpts = new()
+    {
+        PropertyNameCaseInsensitive = true,
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+    };
+
+    private readonly ContentWriterV4DbContext _db;
+
+    public TemplateRepository(ContentWriterV4DbContext db)
+    {
+        _db = db;
+    }
+
+    public async Task<IReadOnlyList<TemplateDto>> GetAllActiveAsync(CancellationToken ct = default)
+    {
+        var entities = await _db.Templates
+            .AsNoTracking()
+            .Where(t => t.IsActive)
+            .OrderBy(t => t.Category)
+            .ThenBy(t => t.Name)
+            .ToListAsync(ct);
+        return entities.Select(MapToDto).ToList().AsReadOnly();
+    }
+
+    public async Task<TemplateDto?> GetBySlugAsync(string slug, CancellationToken ct = default)
+    {
+        var entity = await _db.Templates.AsNoTracking()
+            .FirstOrDefaultAsync(t => t.Slug == slug && t.IsActive, ct);
+        return entity == null ? null : MapToDto(entity);
+    }
+
+    public async Task<TemplateDto?> GetByIdAsync(Guid id, CancellationToken ct = default)
+    {
+        var entity = await _db.Templates.AsNoTracking()
+            .FirstOrDefaultAsync(t => t.Id == id, ct);
+        return entity == null ? null : MapToDto(entity);
+    }
+
+    internal static TemplateDto MapToDto(Template entity)
+    {
+        var fields = JsonSerializer.Deserialize<List<TemplateFieldSchema>>(entity.InputSchemaJson, JsonOpts)
+            ?? new List<TemplateFieldSchema>();
+        return new TemplateDto(
+            entity.Id,
+            entity.Slug,
+            entity.Name,
+            entity.Description,
+            entity.Category,
+            entity.Icon,
+            fields.AsReadOnly(),
+            entity.SystemPrompt,
+            entity.UserPromptTemplate,
+            entity.IsActive,
+            entity.CreatedAtUtc);
+    }
+}
