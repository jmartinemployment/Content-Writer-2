+using System.Net.Http.Json;
+using System.Text;
+using System.Text.Json;
+using GeekApplication.Models.ContentWriterV4;
+
+namespace GeekAPI.HttpClients;
+
+public class HttpContentWriterV4Repository
+{
+    private static readonly JsonSerializerOptions JsonOpts = new()
+    {
+        PropertyNameCaseInsensitive = true,
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+    };
+
+    private readonly HttpClient _httpClient;
+    private readonly ILogger<HttpContentWriterV4Repository> _logger;
+
+    public HttpContentWriterV4Repository(HttpClient httpClient, ILogger<HttpContentWriterV4Repository> logger)
+    {
+        _httpClient = httpClient;
+        _logger = logger;
+    }
+
+    public async Task<IReadOnlyList<TemplateDto>> GetTemplatesAsync(CancellationToken ct = default)
+    {
+        var response = await _httpClient.GetAsync("repo/content-writer-v4/templates", ct);
+        response.EnsureSuccessStatusCode();
+        var content = await response.Content.ReadAsStringAsync(ct);
+        return JsonSerializer.Deserialize<List<TemplateDto>>(content, JsonOpts)?.AsReadOnly()
+            ?? (IReadOnlyList<TemplateDto>)Array.Empty<TemplateDto>();
+    }
+
+    public async Task<TemplateDto?> GetTemplateBySlugAsync(string slug, CancellationToken ct = default)
+    {
+        var response = await _httpClient.GetAsync($"repo/content-writer-v4/templates/{Uri.EscapeDataString(slug)}", ct);
+        if (response.StatusCode == System.Net.HttpStatusCode.NotFound) return null;
+        response.EnsureSuccessStatusCode();
+        var content = await response.Content.ReadAsStringAsync(ct);
+        return JsonSerializer.Deserialize<TemplateDto>(content, JsonOpts);
+    }
+
+    public async Task<TemplateDto?> GetTemplateByIdAsync(Guid id, CancellationToken ct = default)
+    {
+        var response = await _httpClient.GetAsync($"repo/content-writer-v4/templates/by-id/{id}", ct);
+        if (response.StatusCode == System.Net.HttpStatusCode.NotFound) return null;
+        response.EnsureSuccessStatusCode();
+        var content = await response.Content.ReadAsStringAsync(ct);
+        return JsonSerializer.Deserialize<TemplateDto>(content, JsonOpts);
+    }
+
+    public async Task<IReadOnlyList<BrandVoiceDto>> GetBrandVoicesAsync(Guid ownerId, CancellationToken ct = default)
+    {
+        var response = await _httpClient.GetAsync($"repo/content-writer-v4/brand-voices?ownerId={ownerId}", ct);
+        response.EnsureSuccessStatusCode();
+        var content = await response.Content.ReadAsStringAsync(ct);
+        return JsonSerializer.Deserialize<List<BrandVoiceDto>>(content, JsonOpts)?.AsReadOnly()
+            ?? (IReadOnlyList<BrandVoiceDto>)Array.Empty<BrandVoiceDto>();
+    }
+
+    public async Task<BrandVoiceDto?> GetBrandVoiceByIdAsync(Guid id, CancellationToken ct = default)
+    {
+        var response = await _httpClient.GetAsync($"repo/content-writer-v4/brand-voices/{id}", ct);
+        if (response.StatusCode == System.Net.HttpStatusCode.NotFound) return null;
+        response.EnsureSuccessStatusCode();
+        var content = await response.Content.ReadAsStringAsync(ct);
+        return JsonSerializer.Deserialize<BrandVoiceDto>(content, JsonOpts);
+    }
+
+    public async Task<BrandVoiceDto> CreateBrandVoiceAsync(CreateBrandVoiceCommand command, CancellationToken ct = default)
+    {
+        var response = await _httpClient.PostAsJsonAsync("repo/content-writer-v4/brand-voices", command, JsonOpts, ct);
+        response.EnsureSuccessStatusCode();
+        var content = await response.Content.ReadAsStringAsync(ct);
+        return JsonSerializer.Deserialize<BrandVoiceDto>(content, JsonOpts)
+            ?? throw new InvalidOperationException("Failed to deserialize brand voice");
+    }
+
+    public async Task<BrandVoiceDto?> UpdateBrandVoiceAsync(Guid id, UpdateBrandVoiceCommand command, CancellationToken ct = default)
+    {
+        var response = await _httpClient.PutAsJsonAsync($"repo/content-writer-v4/brand-voices/{id}", command, JsonOpts, ct);
+        if (response.StatusCode == System.Net.HttpStatusCode.NotFound) return null;
