+using Microsoft.EntityFrameworkCore;
+
+namespace GeekRepository.Hosting;
+
+/// <summary>
+/// Seeds Content Writer V4 template catalog and provider pricing when empty.
+/// Idempotent — no-ops when templates already exist.
+/// </summary>
+public sealed class ContentWriterV4SeedHostedService : IHostedService
+{
+    private static readonly JsonSerializerOptions JsonOpts = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+    };
+
+    private readonly IServiceProvider _services;
+    private readonly ILogger<ContentWriterV4SeedHostedService> _logger;
+
+    public ContentWriterV4SeedHostedService(
+        IServiceProvider services,
+        ILogger<ContentWriterV4SeedHostedService> logger)
+    {
+        _services = services;
+        _logger = logger;
+    }
+
+    public async Task StartAsync(CancellationToken cancellationToken)
+    {
+        using var scope = _services.CreateScope();
+        var db = scope.ServiceProvider.GetRequiredService<ContentWriterV4DbContext>();
+
+        try
+        {
+            if (!await db.Templates.AnyAsync(cancellationToken))
+            {
+                db.Templates.AddRange(BuildTemplates());
+                await db.SaveChangesAsync(cancellationToken);
+                _logger.LogInformation("ContentWriterV4 seeded {Count} templates.", 6);
+            }
+
+            if (!await db.ProviderModels.AnyAsync(cancellationToken))
+            {
+                db.ProviderModels.AddRange(BuildProviderModels());
+                await db.SaveChangesAsync(cancellationToken);
+                _logger.LogInformation("ContentWriterV4 seeded provider_models pricing rows.");
+            }
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError(ex, "ContentWriterV4 seed failed; continuing startup.");
+        }
+    }
+
+    public Task StopAsync(CancellationToken cancellationToken) => Task.CompletedTask;
+
