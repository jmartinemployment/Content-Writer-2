+        {
+            query = from g in query
+                    join d in _db.Documents.AsNoTracking() on g.DocumentId equals d.Id into docs
+                    from d in docs.DefaultIfEmpty()
+                    where g.DocumentId == null || (d != null && d.OwnerId == ownerId.Value)
+                    select g;
+        }
+
+        var rows = await query.ToListAsync(ct);
+        var byProvider = rows
+            .GroupBy(g => g.Provider)
+            .Select(g => new UsageByProviderDto(
+                g.Key,
+                g.Count(),
+                g.Sum(x => x.InputTokens),
+                g.Sum(x => x.OutputTokens),
+                g.Sum(x => x.CostUsd)))
+            .OrderBy(x => x.Provider)
+            .ToList()
+            .AsReadOnly();
+
+        return new UsageSummaryDto(
+            rows.Count,
+            rows.Sum(x => x.InputTokens),
+            rows.Sum(x => x.OutputTokens),
+            rows.Sum(x => x.CostUsd),
+            byProvider);
+    }
+
+    private static GenerationDto MapToDto(Generation entity)
+    {
+        using var doc = JsonDocument.Parse(string.IsNullOrWhiteSpace(entity.InputsJson) ? "{}" : entity.InputsJson);
+        return new GenerationDto(
+            entity.Id,
+            entity.DocumentId,
+            entity.TemplateId,
+            entity.BrandVoiceId,
+            entity.Provider,
+            entity.Model,
+            doc.RootElement.Clone(),
+            entity.Output,
+            entity.InputTokens,
+            entity.OutputTokens,
+            entity.CostUsd,
+            entity.CreatedAtUtc);
+    }
+}
+
+public class GenerationCostCalculator : IGenerationCostCalculator
+{
+    private readonly ContentWriterV4DbContext _db;
+    private readonly ILogger<GenerationCostCalculator> _logger;
+
+    public GenerationCostCalculator(ContentWriterV4DbContext db, ILogger<GenerationCostCalculator> logger)
+    {
+        _db = db;
+        _logger = logger;
+    }
+
+    public async Task<decimal> CalculateCostUsdAsync(
+        string provider,
+        string model,
+        int inputTokens,
+        int outputTokens,
+        CancellationToken ct = default)
+    {
+        var pricing = await _db.ProviderModels.AsNoTracking()
+            .Where(p => p.IsActive && p.Provider == provider && p.Model == model)
+            .OrderByDescending(p => p.EffectiveAtUtc)
+            .FirstOrDefaultAsync(ct);
+
+        if (pricing == null)
+        {
+            _logger.LogWarning(
+                "No provider_models row for {Provider}/{Model}; persisting cost_usd=0",
+                provider, model);
+            return 0m;
+        }
+
+        return (inputTokens / 1000m) * pricing.InputCostPer1k
+             + (outputTokens / 1000m) * pricing.OutputCostPer1k;
+    }
+}
