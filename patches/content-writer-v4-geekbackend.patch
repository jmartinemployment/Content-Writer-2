@@ -0,0 +1,30 @@
+using GeekApplication.Interfaces.ContentWriterV4;
+
+namespace GeekAPI.Services.ContentWriterV4;
+
+public interface ILlmProviderV4Factory
+{
+    ILlmProviderV4 GetProvider(string? providerName);
+    IReadOnlyList<string> GetRegisteredProviderNames();
+}
+
+public sealed class LlmProviderV4Factory : ILlmProviderV4Factory
+{
+    private readonly IReadOnlyDictionary<string, ILlmProviderV4> _providers;
+
+    public LlmProviderV4Factory(IEnumerable<ILlmProviderV4> providers)
+    {
+        _providers = providers.ToDictionary(p => p.ProviderName, StringComparer.OrdinalIgnoreCase);
+    }
+
+    public ILlmProviderV4 GetProvider(string? providerName)
+    {
+        var key = string.IsNullOrWhiteSpace(providerName) ? "openai" : providerName.Trim();
+        if (_providers.TryGetValue(key, out var provider))
+            return provider;
+        throw new InvalidOperationException($"Unknown LLM provider '{key}'. Registered: {string.Join(", ", _providers.Keys)}");
+    }
+
+    public IReadOnlyList<string> GetRegisteredProviderNames() =>
+        _providers.Keys.OrderBy(k => k).ToList().AsReadOnly();
+}
